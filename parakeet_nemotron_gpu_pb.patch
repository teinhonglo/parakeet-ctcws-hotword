diff --git a/scripts/evaluate_nemotron_benchmark.sh b/scripts/evaluate_nemotron_benchmark.sh
new file mode 100644
index 0000000..9c8a30c
--- /dev/null
+++ b/scripts/evaluate_nemotron_benchmark.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ "$#" -ne 2 ]]; then
+  echo "Usage: $0 <benchmark_dir> <nemotron_exp_dir>" >&2
+  exit 2
+fi
+
+benchmark_dir="$(cd "$1" && pwd)"
+exp_dir="$(cd "$2" && pwd)"
+
+python "${benchmark_dir}/evaluate.py" \
+  --candidate "${exp_dir}/raw_asr" \
+  --output "${exp_dir}/report_raw_asr.xlsx"
+
+python "${benchmark_dir}/evaluate.py" \
+  --candidate "${exp_dir}/gpu_pb_asr" \
+  --output "${exp_dir}/report_gpu_pb_asr.xlsx"
